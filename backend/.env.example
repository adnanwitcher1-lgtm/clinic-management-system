# ---- Django ----
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database: "postgres" or "sqlite" (sqlite = quick local try-out) ----
DB_ENGINE=postgres
DB_NAME=clinic_db
DB_USER=clinic_user
DB_PASSWORD=clinic_pass
DB_HOST=localhost
DB_PORT=5432

# ---- Celery + Redis (WhatsApp / PDF background jobs) ----
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Set to 1 to run jobs inline without Redis (handy for development)
CELERY_EAGER=0

# ---- WhatsApp Cloud API (optional; can also be set from Admin > Settings) ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
