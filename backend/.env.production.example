# Copy to backend/.env on the server and fill in.
SECRET_KEY=put-a-long-random-string-here
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com

DB_ENGINE=postgres
DB_NAME=clinic_db
DB_USER=clinic_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_EAGER=0
TIME_ZONE=Asia/Karachi

# Used only by `python manage.py seed_initial` (first run). If empty, random passwords are printed once.
ADMIN_PASSWORD=
DOCTOR_PASSWORD=
